{
  "name": "pi-qcode",
  "displayName": "pi-qcode",
  "description": "Native UI vscode extension for pi coding agent. UI is powered by the pi cli in the terminal window. See Prerequisites for details.",
  "version": "0.0.3",
  "publisher": "QuincyMitchell",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:pi-qcode.home",
    "onCommand:pi-qcode.addToQcode",
    "onCommand:pi-qcode.addTerminalSelectionToQcode"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-qcode",
          "title": "pi-qcode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pi-qcode": [
        {
          "type": "webview",
          "id": "pi-qcode.home",
          "name": "v0.0.3"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-qcode.addToQcode",
        "title": "Add to pi-qcode"
      },
      {
        "command": "pi-qcode.addTerminalSelectionToQcode",
        "title": "Add to pi-qcode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pi-qcode.addToQcode",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "command": "pi-qcode.addTerminalSelectionToQcode",
          "when": "terminalTextSelected",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-qcode.addTerminalSelectionToQcode",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi-qcode.addToQcode",
        "key": "ctrl+;",
        "mac": "cmd+;",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "package-install": "npm run compile && vsce package --allow-missing-repository --out pi-qcode-0.0.3.vsix && code --install-extension pi-qcode-0.0.3.vsix --force",
    "package-uninstall": "code --uninstall-extension QuincyMitchell.pi-qcode"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}