{
  "name": "pi-qcode",
  "displayName": "pi-qcode",
  "description": "Native UI vscode extension for pi coding agent. UI is powered by the pi cli in the terminal window.",
  "version": "0.1.6",
  "publisher": "QuincyMitchell",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-qcode",
          "title": "pi-qcode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pi-qcode": [
        {
          "type": "webview",
          "id": "pi-qcode.home",
          "name": "Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-qcode.addToQcode",
        "title": "Add to pi-qcode"
      },
      {
        "command": "pi-qcode.addTerminalSelectionToQcode",
        "title": "Add to pi-qcode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pi-qcode.addToQcode",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "command": "pi-qcode.addTerminalSelectionToQcode",
          "when": "terminalTextSelected",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-qcode.addTerminalSelectionToQcode",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi-qcode.addToQcode",
        "key": "ctrl+;",
        "mac": "cmd+;",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copy-mermaid.cjs && tsc --project tsconfig.json",
    "watch": "node scripts/copy-mermaid.cjs && tsc --watch --project tsconfig.json",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "npm run compile && vsce package --allow-missing-repository --out pi-qcode.vsix && npm run package:verify",
    "package:verify": "node scripts/verify-vsix.cjs pi-qcode.vsix",
    "package-install": "npm run package && code --install-extension pi-qcode.vsix --force",
    "package-uninstall": "code --uninstall-extension QuincyMitchell.pi-qcode"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.2",
    "mermaid": "11.16.1",
    "typescript": "^6.0.3"
  }
}