{
  "name": "qcode",
  "displayName": "QCode",
  "description": "A bare minimal VS Code extension home screen for recent Pi sessions.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:qcode.home",
    "onCommand:qcode.addToQcode"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qcode",
          "title": "QCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "qcode": [
        {
          "type": "webview",
          "id": "qcode.home",
          "name": "Home"
        }
      ]
    },
    "commands": [
      {
        "command": "qcode.addToQcode",
        "title": "Add to QCode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "qcode.addToQcode",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "qcode.addToQcode",
        "key": "ctrl+;",
        "mac": "cmd+;",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "package-install": "npm run compile && vsce package --allow-missing-repository --out qcode-0.0.1.vsix && code --install-extension qcode-0.0.1.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^6.0.3"
  }
}